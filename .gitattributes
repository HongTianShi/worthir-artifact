# 确保源码包中的 POSIX 启动器可执行，并让 Windows 文件保持可读。
* text=auto

*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf
worthir text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf

*.joblib binary
*.npz binary
*.parquet binary
*.pdf binary
*.png binary
